{
  "name": "horizon-discord-agent",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "lint": "eslint bin lib --ext .ts",
    "format:check": "prettier --check \"bin/**/*.ts\" \"lib/**/*.ts\" \"scripts/**/*.ts\"",
    "presynth": "bash scripts/check-docker.sh",
    "synth": "cdk synth",
    "sam:invoke": "sam local invoke --no-staging",
    "seed:dev": "ts-node scripts/seed-config.ts --env dev"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1059.0",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "aws-cdk": "2.1125.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30",
    "prettier": "^3.8.3",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.257.0",
    "constructs": "^10.5.0"
  }
}
